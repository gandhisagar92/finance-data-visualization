{
  "name": "finance-data-visualization-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build:css": "postcss src/index.css -o dist/assets/styles.css",
    "build:js": "esbuild src/main.tsx --bundle --outfile=dist/assets/bundle.js --format=esm --sourcemap --loader:.ts=ts --loader:.tsx=tsx",
    "build": "rm -rf dist && mkdir -p dist/assets && cp index.html dist/index.html && npm run build:css && npm run build:js",
    "start": "node ./server-placeholder.js"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "lucide-react": "^0.454.0",
    "axios": "^1.7.7"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.23.1",
    "postcss": "^8.4.47",
    "postcss-cli": "^10.1.0",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.6.2"
  }
}